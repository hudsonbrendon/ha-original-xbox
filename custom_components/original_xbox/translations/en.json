  "services": {
    "launch": {
      "name": "Launch XBE",
      "description": "Launch a game or app by library name or .xbe path (e.g. F:\\Games\\Halo 2\\default.xbe).",
      "fields": {
        "path": {
          "name": "Path or name",
          "description": "Game name or .xbe path."
        },
        "config_entry_id": {
          "name": "Xbox",
          "description": "Xbox config entry (optional when only one console is configured)."
        }
      }
    },
    "site_command": {
      "name": "SITE command",
      "description": "Send a raw FTP SITE command to the dashboard (DRIVESTAT, MD5 C:\\file, TRAYOPEN...) and return the reply.",
      "fields": {
        "command": {
          "name": "Command",
          "description": "E.g. DRIVESTAT"
        },
        "config_entry_id": {
          "name": "Xbox",
          "description": "Xbox config entry (optional when only one console is configured)."
        }
      }
    },
    "upload_file": {
      "name": "Upload file",
      "description": "Upload a file from Home Assistant to the Xbox (ROMs, skins, configs).",
      "fields": {
        "source": {
          "name": "Source",
          "description": "Path on Home Assistant (must be in allowlist_external_dirs)."
        },
        "destination": {
          "name": "Destination",
          "description": "Path on the Xbox; end it with \\ to keep the file name."
        },
        "config_entry_id": {
          "name": "Xbox",
          "description": "Xbox config entry (optional when only one console is configured)."
        }
      }
    },
    "upload_folder": {
      "name": "Upload folder (add game)",
      "description": "Copy a folder from Home Assistant to the Xbox (default F:\\Games\\<folder name>) and refresh the library.",
      "fields": {
        "source": {
          "name": "Source folder",
          "description": "Folder on Home Assistant containing default.xbe (e.g. /media/games/My Game)."
        },
        "destination": {
          "name": "Destination",
          "description": "Optional. Default: F:\\Games\\<folder name>."
        },
        "config_entry_id": {
          "name": "Xbox",
          "description": "Xbox config entry (optional when only one console is configured)."
        }
      }
    },
    "download_file": {
      "name": "Download file",
      "description": "Copy a file from the Xbox to Home Assistant.",
      "fields": {
        "source": {
          "name": "Source",
          "description": "Path on the Xbox (e.g. C:\\Config.xml)."
        },
        "destination": {
          "name": "Destination",
          "description": "Path on Home Assistant (must be in allowlist_external_dirs)."
        },
        "config_entry_id": {
          "name": "Xbox",
          "description": "Xbox config entry (optional when only one console is configured)."
        }
      }
    },
    "list_folder": {
      "name": "List folder",
      "description": "List a folder on the Xbox.",
      "fields": {
        "path": {
          "name": "Folder",
          "description": "E.g. F:\\Games"
        },
        "config_entry_id": {
          "name": "Xbox",
          "description": "Xbox config entry (optional when only one console is configured)."
        }
      }
    },
    "xbmc_command": {
      "name": "XBMC command",
      "description": "Run an XBMC command (HTTP API, e.g. ExecBuiltIn with XBMC.ActivateWindow(MyMusic)).",
      "fields": {
        "command": {
          "name": "Command",
          "description": "E.g. GetCurrentlyPlaying"
        },
        "parameter": {
          "name": "Parameter",
          "description": "Optional."
        },
        "config_entry_id": {
          "name": "Xbox",
          "description": "Xbox config entry (optional when only one console is configured)."
        }
      }
    },
    "backup_saves": {
      "name": "Back up saves",
      "description": "Zip E:\\UDATA into /config/backups/original_xbox/.",
      "fields": {
        "config_entry_id": {
          "name": "Xbox",
          "description": "Xbox config entry (optional when only one console is configured)."
        }
      }
    },
    "refresh_library": {
      "name": "Refresh library",
      "description": "Rescan games, apps and saves.",
      "fields": {
        "config_entry_id": {
          "name": "Xbox",
          "description": "Xbox config entry (optional when only one console is configured)."
        }
      }
    }
  }
